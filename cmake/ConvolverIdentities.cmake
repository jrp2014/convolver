# Reads plugins/identities.json (PLUG-4), the one record of permanent plug-in
# identities and channel layouts, and writes generated/convolver_identities.hpp
# for the adapters. Also sets CONVOLVER_ID_* variables for bundle metadata.
# tests/identities_tests.py checks the registry's rules and frozen values.
set(convolver_identities_dir "${CMAKE_CURRENT_LIST_DIR}")
set(convolver_identities_file "${CMAKE_CURRENT_LIST_DIR}/../plugins/identities.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${convolver_identities_file}")
file(READ "${convolver_identities_file}" convolver_identities_json)

function(convolver_identity out)
    string(JSON value ERROR_VARIABLE error GET "${convolver_identities_json}" ${ARGN})
    if(error)
        message(FATAL_ERROR "plugins/identities.json: ${error}")
    endif()
    # Values become C++ string literals: keep them free of quotes and backslashes.
    if(value MATCHES "[\"\\\\]")
        message(FATAL_ERROR "plugins/identities.json: ${ARGN}: no quotes or backslashes")
    endif()
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

function(convolver_identity_length out)
    string(JSON value ERROR_VARIABLE error LENGTH "${convolver_identities_json}" ${ARGN})
    if(error)
        message(FATAL_ERROR "plugins/identities.json: ${error}")
    endif()
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

function(convolver_class_id_words out hex)
    if(NOT hex MATCHES "^[0-9A-F]+$")
        message(FATAL_ERROR "plugins/identities.json: VST3 class ID ${hex} is not 32 uppercase hex digits")
    endif()
    string(LENGTH "${hex}" length)
    if(NOT length EQUAL 32)
        message(FATAL_ERROR "plugins/identities.json: VST3 class ID ${hex} is not 32 uppercase hex digits")
    endif()
    set(words "")
    foreach(offset 0 8 16 24)
        string(SUBSTRING "${hex}" ${offset} 8 word)
        list(APPEND words "0x${word}U")
    endforeach()
    list(JOIN words ", " words)
    set(${out} "${words}" PARENT_SCOPE)
endfunction()

# A function keeps the working variables out of the including directory's scope.
function(convolver_generate_identities)
convolver_identity(CONVOLVER_ID_VENDOR vendor name)
convolver_identity(CONVOLVER_ID_VENDOR_URL vendor url)
convolver_identity(convolver_vst3_processor vst3 processor_class_id)
convolver_identity(convolver_vst3_controller vst3 controller_class_id)
convolver_identity(CONVOLVER_ID_VST3_BUNDLE vst3 macos_bundle_id)
convolver_identity(convolver_vst3_bypass_parameter vst3 bypass_parameter_id)
convolver_identity(convolver_vst3_status_parameter vst3 status_parameter_id)
convolver_identity(convolver_au_status_parameter au status_parameter_id)
convolver_identity(convolver_au_gain_parameter au gain_parameter_id)
convolver_identity(convolver_au_gain_mode_parameter au gain_mode_parameter_id)
convolver_identity(convolver_au_mix_parameter au mix_parameter_id)
convolver_identity(convolver_au_latency_parameter au latency_parameter_id)
foreach(id IN ITEMS "${convolver_vst3_bypass_parameter}" "${convolver_vst3_status_parameter}" "${convolver_au_status_parameter}"
        "${convolver_au_gain_parameter}" "${convolver_au_gain_mode_parameter}" "${convolver_au_mix_parameter}"
        "${convolver_au_latency_parameter}")
    if(NOT id MATCHES "^[0-9]+$")
        message(FATAL_ERROR "plugins/identities.json: parameter ID '${id}' is not a whole number")
    endif()
endforeach()
convolver_identity(CONVOLVER_ID_AU_TYPE au type)
convolver_identity(CONVOLVER_ID_AU_SUBTYPE au subtype)
convolver_identity(CONVOLVER_ID_AU_MANUFACTURER au manufacturer)
convolver_identity(CONVOLVER_ID_AU_BUNDLE au macos_bundle_id)
convolver_identity(CONVOLVER_ID_LV2_BASE lv2 base_uri)
convolver_identity(CONVOLVER_ID_LV2_BUNDLE lv2 bundle)
convolver_identity(convolver_min_channels channels minimum)
convolver_identity(convolver_max_channels channels maximum)
convolver_identity(convolver_unequal_counts channels unequal_counts)
foreach(code IN ITEMS "${CONVOLVER_ID_AU_TYPE}" "${CONVOLVER_ID_AU_SUBTYPE}" "${CONVOLVER_ID_AU_MANUFACTURER}")
    if(NOT code MATCHES "^[ -~][ -~][ -~][ -~]$")
        message(FATAL_ERROR "plugins/identities.json: AU code '${code}' is not four printable ASCII characters")
    endif()
endforeach()
convolver_class_id_words(convolver_vst3_processor_words "${convolver_vst3_processor}")
convolver_class_id_words(convolver_vst3_controller_words "${convolver_vst3_controller}")
if(convolver_unequal_counts)
    set(convolver_unequal_counts true)
else()
    set(convolver_unequal_counts false)
endif()

set(convolver_layouts "")
convolver_identity_length(count fixed_layouts)
math(EXPR last "${count} - 1")
if(count LESS 1)
    message(FATAL_ERROR "plugins/identities.json: fixed_layouts is empty")
endif()
foreach(index RANGE ${last})
    convolver_identity(id fixed_layouts ${index} id)
    convolver_identity(inputs fixed_layouts ${index} inputs)
    convolver_identity(outputs fixed_layouts ${index} outputs)
    set(sides "")
    foreach(side input output)
        convolver_identity(meaning fixed_layouts ${index} ${side})
        if(meaning STREQUAL "discrete")
            list(APPEND sides "Meaning::discrete")
        elseif(meaning STREQUAL "named")
            list(APPEND sides "Meaning::named")
        else()
            message(FATAL_ERROR "plugins/identities.json: layout ${id}: ${side} must be discrete or named")
        endif()
    endforeach()
    list(GET sides 0 input)
    list(GET sides 1 output)
    string(APPEND convolver_layouts "    {\"${id}\", ${inputs}, ${outputs}, ${input}, ${output}},\n")
endforeach()
set(convolver_layout_count ${count})

set(convolver_speakers "")
convolver_identity_length(count speakers)
math(EXPR last "${count} - 1")
if(count LESS 1)
    message(FATAL_ERROR "plugins/identities.json: speakers is empty")
endif()
foreach(index RANGE ${last})
    convolver_identity(bit speakers ${index} bit)
    if(NOT bit EQUAL index)
        message(FATAL_ERROR "plugins/identities.json: speakers must list bits 0, 1, 2, ... in order")
    endif()
    convolver_identity(wav speakers ${index} wav)
    convolver_identity(lv2 speakers ${index} lv2)
    string(APPEND convolver_speakers "    {\"${wav}\", \"${lv2}\"},\n")
endforeach()
set(convolver_speaker_count ${count})

configure_file("${convolver_identities_dir}/convolver_identities.hpp.in"
    "${CMAKE_CURRENT_BINARY_DIR}/generated/convolver_identities.hpp" @ONLY)
foreach(name VENDOR VENDOR_URL VST3_BUNDLE AU_TYPE AU_SUBTYPE AU_MANUFACTURER AU_BUNDLE LV2_BASE LV2_BUNDLE)
    set(CONVOLVER_ID_${name} "${CONVOLVER_ID_${name}}" PARENT_SCOPE)
endforeach()
endfunction()
convolver_generate_identities()
