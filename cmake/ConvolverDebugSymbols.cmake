# DIAG-1 (jrp's review of 24 October 2026): preview binaries keep matching
# debugging symbols, so a crash report from a user can be symbolicated against
# the exact binary. With CONVOLVER_DEBUG_SYMBOLS, Release code is compiled
# with debug information (the generated code does not change), and
# convolver_keep_symbols() moves each packaged binary's symbols to
# symbols/ in the build folder, outside everything that is installed:
#   - Linux: <file>.debug (objcopy --only-keep-debug), with the binary
#     stripped of debug sections and pointing to it (--add-gnu-debuglink);
#     the GNU build ID matches the two.
#   - macOS: <file>.dSYM (dsymutil), with the binary stripped of its debug
#     map (strip -S) and signed again ad hoc; the Mach-O UUID matches them.
#   - Windows: <file>.pdb, written there by the linker (/DEBUG); the PDB's
#     signature in the binary matches them. /OPT:REF and /OPT:ICF keep the
#     code as a Release link without /DEBUG would.
# scripts/release/candidate.py turns it on; ordinary builds leave it off.
option(CONVOLVER_DEBUG_SYMBOLS "Keep debugging symbols for packaged binaries in symbols/ (release candidates)" OFF)
set(CONVOLVER_SYMBOLS_DIR "${CMAKE_BINARY_DIR}/symbols")
if(CONVOLVER_DEBUG_SYMBOLS)
    if(MSVC)
        string(APPEND CMAKE_CXX_FLAGS_RELEASE " /Zi")
        foreach(kind SHARED MODULE EXE)
            string(APPEND CMAKE_${kind}_LINKER_FLAGS_RELEASE " /DEBUG /OPT:REF /OPT:ICF /INCREMENTAL:NO")
        endforeach()
    else()
        string(APPEND CMAKE_CXX_FLAGS_RELEASE " -g")
    endif()
    if(NOT MSVC AND NOT APPLE)
        if(NOT CMAKE_OBJCOPY OR NOT CMAKE_STRIP)
            message(FATAL_ERROR "CONVOLVER_DEBUG_SYMBOLS needs objcopy and strip (binutils)")
        endif()
        # The VST3 SDK strips its plug-ins itself in Linux Release builds, as
        # its first step after linking ("strip --strip-debug --strip-unneeded
        # FILE"). plugins/vst3/CMakeLists.txt passes it this strip instead,
        # which keeps the symbols first and links the binary to them.
        set(CONVOLVER_SDK_STRIP "${CMAKE_BINARY_DIR}/convolver-strip-keeping-symbols.sh")
        file(WRITE "${CONVOLVER_SDK_STRIP}" "#!/bin/sh
# Generated by cmake/ConvolverDebugSymbols.cmake: strip that keeps the symbols.
set -e
for file; do :; done
kept=\"${CONVOLVER_SYMBOLS_DIR}/\$(basename \"\$file\").debug\"
mkdir -p \"${CONVOLVER_SYMBOLS_DIR}\"
\"${CMAKE_OBJCOPY}\" --only-keep-debug \"\$file\" \"\$kept\"
\"${CMAKE_STRIP}\" \"\$@\"
\"${CMAKE_OBJCOPY}\" \"--add-gnu-debuglink=\$kept\" \"\$file\"
")
        file(CHMOD "${CONVOLVER_SDK_STRIP}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE
            GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    endif()
endif()

# Call before any other POST_BUILD step that signs the target (the VST3
# bundle's codesign), so that signing comes last. SDK_STRIPPED: the target
# was made with CMAKE_STRIP set to CONVOLVER_SDK_STRIP, which keeps its
# symbols on Linux already.
function(convolver_keep_symbols target)
    cmake_parse_arguments(PARSE_ARGV 1 keep "SDK_STRIPPED" "" "")
    if(NOT CONVOLVER_DEBUG_SYMBOLS OR (keep_SDK_STRIPPED AND CONVOLVER_SDK_STRIP))
        return()
    endif()
    file(MAKE_DIRECTORY "${CONVOLVER_SYMBOLS_DIR}")
    set(file "$<TARGET_FILE:${target}>")
    set(kept "${CONVOLVER_SYMBOLS_DIR}/$<TARGET_FILE_NAME:${target}>")
    if(MSVC)
        # Multi-configuration generators add the configuration's folder.
        set_target_properties(${target} PROPERTIES PDB_OUTPUT_DIRECTORY "${CONVOLVER_SYMBOLS_DIR}")
    elseif(APPLE)
        add_custom_command(TARGET ${target} POST_BUILD
            COMMAND "${CMAKE_COMMAND}" -E rm -rf "${kept}.dSYM"
            COMMAND dsymutil "${file}" -o "${kept}.dSYM"
            COMMAND "${CMAKE_STRIP}" -S "${file}"
            COMMAND codesign --force --sign - --timestamp=none "${file}"
            VERBATIM)
    else()
        add_custom_command(TARGET ${target} POST_BUILD
            COMMAND "${CMAKE_OBJCOPY}" --only-keep-debug "${file}" "${kept}.debug"
            COMMAND "${CMAKE_OBJCOPY}" --strip-debug "--add-gnu-debuglink=${kept}.debug" "${file}"
            VERBATIM)
    endif()
endfunction()
