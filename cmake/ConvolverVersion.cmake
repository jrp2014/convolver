file(READ "${CMAKE_CURRENT_LIST_DIR}/../VERSION" CONVOLVER_VERSION)
string(STRIP "${CONVOLVER_VERSION}" CONVOLVER_VERSION)
if(NOT CONVOLVER_VERSION MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$")
    message(FATAL_ERROR "VERSION must contain MAJOR.MINOR.PATCH without leading zeros")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/../VERSION")
