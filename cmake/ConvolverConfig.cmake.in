@PACKAGE_INIT@

set(Convolver_VERSION "@PROJECT_VERSION@")
set(Convolver_FFT_BACKEND "@fft_backend@")
set(Convolver_core_FOUND FALSE)
set(Convolver_io_FOUND FALSE)

# A function scopes our module search path and lookup variables to this package.
# Imported targets remain visible in the directory calling find_package.
function(_convolver_dependencies)
    list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
    find_package(Threads QUIET)
    if(NOT Threads_FOUND)
        set(Convolver_NOT_FOUND_MESSAGE "Convolver needs Threads" PARENT_SCOPE)
        return()
    endif()
    if(Convolver_FFT_BACKEND STREQUAL "FFTW")
        find_package(ConvolverFFTW QUIET)
        if(NOT ConvolverFFTW_FOUND)
            set(Convolver_NOT_FOUND_MESSAGE "Convolver needs single-precision FFTW" PARENT_SCOPE)
            return()
        endif()
    elseif(NOT APPLE)
        set(Convolver_NOT_FOUND_MESSAGE "This Convolver package requires Apple Accelerate" PARENT_SCOPE)
        return()
    endif()
    set(Convolver_core_FOUND TRUE PARENT_SCOPE)
    if("io" IN_LIST Convolver_FIND_COMPONENTS AND
       EXISTS "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/ConvolverIOTargets.cmake")
        find_package(ConvolverSndFile QUIET)
        if(ConvolverSndFile_FOUND)
            set(Convolver_io_FOUND TRUE PARENT_SCOPE)
        endif()
    endif()
endfunction()
_convolver_dependencies()
if(NOT Convolver_core_FOUND)
    set(Convolver_FOUND FALSE)
    return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/ConvolverCoreTargets.cmake")
if(Convolver_io_FOUND)
    include("${CMAKE_CURRENT_LIST_DIR}/ConvolverIOTargets.cmake")
endif()
foreach(component IN LISTS Convolver_FIND_COMPONENTS)
    if(NOT component MATCHES "^(core|io)$")
        set(Convolver_${component}_FOUND FALSE)
    endif()
    if(NOT Convolver_${component}_FOUND AND Convolver_FIND_REQUIRED_${component})
        set(Convolver_NOT_FOUND_MESSAGE "Convolver component '${component}' is unavailable or its dependencies are missing")
    endif()
endforeach()
check_required_components(Convolver)
