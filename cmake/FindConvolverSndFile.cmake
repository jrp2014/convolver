if(NOT TARGET SndFile::sndfile)
    find_package(SndFile CONFIG QUIET)
endif()
if(NOT TARGET SndFile::sndfile)
    find_package(PkgConfig QUIET)
    if(PkgConfig_FOUND)
        pkg_check_modules(SNDFILE QUIET IMPORTED_TARGET sndfile)
    endif()
    if(TARGET PkgConfig::SNDFILE)
        # A real imported interface target keeps the installed dependency name
        # stable even if the producer and consumer use different lookup methods.
        add_library(SndFile::sndfile INTERFACE IMPORTED)
        set_property(TARGET SndFile::sndfile PROPERTY INTERFACE_LINK_LIBRARIES PkgConfig::SNDFILE)
    endif()
endif()
if(TARGET SndFile::sndfile)
    set(ConvolverSndFile_FOUND TRUE)
else()
    find_path(SNDFILE_INCLUDE_DIR sndfile.h)
    find_library(SNDFILE_LIBRARY NAMES sndfile libsndfile-1)
    include(FindPackageHandleStandardArgs)
    find_package_handle_standard_args(ConvolverSndFile REQUIRED_VARS SNDFILE_INCLUDE_DIR SNDFILE_LIBRARY)
    if(ConvolverSndFile_FOUND)
        add_library(SndFile::sndfile UNKNOWN IMPORTED)
        set_target_properties(SndFile::sndfile PROPERTIES
            IMPORTED_LOCATION "${SNDFILE_LIBRARY}"
            INTERFACE_INCLUDE_DIRECTORIES "${SNDFILE_INCLUDE_DIR}")
    endif()
endif()
