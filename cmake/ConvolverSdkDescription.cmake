# convolver_sdk_description(<label> <sdk-directory>)
#
# Names the exact SDK a plug-in is built with, for the Convolver log (CI-6):
# "VST3 SDK 3.8.1_build_84, commit 3cdf9ca5d1f5", as CONVOLVER_SDK_DESCRIPTION
# in a generated convolver_sdk.hpp, which every target the calling directory
# defines afterwards can include. scripts/release/sources.py
# leaves a .convolver-source.json record in each SDK it unpacks; a Git
# checkout is described by `git describe`; anything else is "version not
# recorded".
function(convolver_sdk_description label directory)
    set(description "${label}, version not recorded")
    set(record "${directory}/.convolver-source.json")
    if(EXISTS "${record}")
        file(READ "${record}" json)
        string(JSON version ERROR_VARIABLE version_error GET "${json}" version)
        string(JSON revision ERROR_VARIABLE revision_error GET "${json}" revision)
        if(NOT version_error AND NOT revision_error)
            string(SUBSTRING "${revision}" 0 12 short)
            set(description "${label} ${version}, commit ${short}")
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${record}")
    elseif(EXISTS "${directory}/.git")
        find_package(Git QUIET)
        if(GIT_FOUND)
            execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${directory}" describe --tags --always --dirty
                OUTPUT_VARIABLE described OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE failed)
            if(NOT failed AND described)
                set(description "${label} ${described} (Git checkout)")
            endif()
        endif()
    endif()
    # The text becomes a C++ string literal.
    string(REGEX REPLACE "[\"\\\\]" "" description "${description}")
    message(STATUS "Convolver: ${description}")
    set(generated "${CMAKE_CURRENT_BINARY_DIR}/generated-sdk")
    file(CONFIGURE OUTPUT "${generated}/convolver_sdk.hpp" CONTENT
        "// Generated by cmake/ConvolverSdkDescription.cmake.\n#pragma once\n#define CONVOLVER_SDK_DESCRIPTION \"@description@\"\n"
        @ONLY)
    include_directories("${generated}")
endfunction()
