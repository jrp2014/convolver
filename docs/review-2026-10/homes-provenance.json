  "recommendations": [
    {
      "decision": "selective candidate",
      "files": [
        "convolution/channelpaths.cpp",
        "convolution/convolution.cpp"
      ],
      "change": "4.5 snapshot checks stream badbit before failbit, preserving distinct fatal I/O diagnostics because badbit makes fail() true too. Keep existing checkout version strings; do not label as full4.5 release."
    },
    {
      "decision": "selective candidate",
      "files": [
        "convolution/channelpaths.cpp"
      ],
      "change": "4.4 latency display adds nHalfPartitionLength tap count beside seconds. No DSP algorithm change."
    },
    {
      "decision": "conditional candidate",
      "files": [
        "convolution/wavefile.h",
        "convolution/wavefile.cpp",
        "convolution/exception.h"
      ],
      "change": "4.4 fd-based libsndfile wrapper and formatlookup are self-contained plumbing used by Pipe. Useful only if adding an actual consumer; wavefile.cpp must be linked with that consumer. Keep LIBSNDFILE guards in mind because SndFileFormat exists only under LIBSNDFILE."
    },
    {
      "decision": "defer",
      "files": [
        "convolverPipe/convolverPipe.cpp"
      ],
      "change": "4.4 addition has missing throw for zero nFilterLengths, zero-vector indexing risk, no EOF tail flush, and caught errors return initial S_OK. Same source in4.5; version alone does not demonstrate stable behavior."
    },
    {
      "decision": "defer",
      "files": [
        "convolverCMD/convolverCMD.cpp"
      ],
      "change": "4.4 adds exactly one cBufferLength final zero block and changes non-libsndfile padding. Requires output length/channel and long-filter testing; not safe to infer correct general tail handling."
    },
    {
      "decision": "exclude",
      "files": [
        "convolution/sample.h"
      ],
      "change": "4.5 disables both64-bit IEEE float registrations; capability reduction unsupported by explanation/test."
    },
    {
      "decision": "exclude wholesale",
      "files": [
        "convolver.sln",
        "Setup/Setup.vdproj",
        "*.vcproj"
      ],
      "change": "4.5 rewrites Setup project identity and duplicates SourceCodeControl sections; projects retain external DScaler and oldSDK/library dependencies. No need to import version and build churn for selected source fixes."
    },
    {
      "decision": "exclude",
      "files": [
        "Media/PerfectDiracDelta-44100-2-2.wav"
      ],
      "change": "Only newly named simple fixture:82bytes, IEEEfloat32 stereo44100Hz; data contains3frames [1,1],[0,0],[0,0], fact sample count0 despite filename2. Do not trust as a two-frame baseline without regeneration/documentation."
    },
    {
      "decision": "exclude media bulk",
      "files": [
