cmake_minimum_required(VERSION 3.20)
# One step of packaging.consumer.*, chosen by -DSTEP=: "install" installs and
# relocates the package (the fixture the installed cases share), and every
# other value builds and tests one consumer in a directory of its own, so
# CTest can run the cases side by side.
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Command failed (${result}): ${ARGV}\n${output}\n${error}")
    endif()
endfunction()

set(root "@CMAKE_CURRENT_BINARY_DIR@/consumer-test")
set(package "${root}/relocated prefix/@package_dir@")
if(STEP STREQUAL "install")
    file(REMOVE_RECURSE "${root}")
    file(MAKE_DIRECTORY "${root}/source")
    # The installed consumer has no access to Convolver's source/header directories.
    file(COPY "@CMAKE_CURRENT_SOURCE_DIR@/tests/consumer/CMakeLists.txt"
        "@CMAKE_CURRENT_SOURCE_DIR@/tests/consumer/main.cpp" DESTINATION "${root}/source")
    run("@CMAKE_COMMAND@" --install "@CMAKE_CURRENT_BINARY_DIR@" --prefix "${root}/original" --config "${CONFIG}")
    file(RENAME "${root}/original" "${root}/relocated prefix")
    message(STATUS "Installed and relocated the package to ${root}/relocated prefix")
    return()
endif()

set(generator_options)
if(NOT "@CMAKE_GENERATOR_PLATFORM@" STREQUAL "")
    list(APPEND generator_options -A "@CMAKE_GENERATOR_PLATFORM@")
endif()
if(NOT "@CMAKE_GENERATOR_TOOLSET@" STREQUAL "")
    list(APPEND generator_options -T "@CMAKE_GENERATOR_TOOLSET@")
endif()
function(consumer name)
    file(REMOVE_RECURSE "${root}/${name}")
    run("@CMAKE_COMMAND@" -S "${root}/source" -B "${root}/${name}"
        -G "@CMAKE_GENERATOR@" ${generator_options}
        -C "@CMAKE_CURRENT_BINARY_DIR@/consumer-cache.cmake"
        "-DConvolver_DIR=${package}" ${ARGN})
    run("@CMAKE_COMMAND@" --build "${root}/${name}" --config "${CONFIG}" --parallel 2)
    run("@CMAKE_CTEST_COMMAND@" --test-dir "${root}/${name}" -C "${CONFIG}" --output-on-failure)
endfunction()
set(no_optional -DCMAKE_DISABLE_FIND_PACKAGE_ConvolverSndFile=ON -DCMAKE_DISABLE_FIND_PACKAGE_Python3=ON)
if(STEP STREQUAL "installed-core")
    consumer(installed-core ${no_optional}
        "-DCONVOLVER_FORBIDDEN_SOURCE=@CMAKE_CURRENT_SOURCE_DIR@/include")
elseif(STEP STREQUAL "missing-host")
    consumer(missing-host -DMISSING_COMPONENT=host)
elseif(STEP STREQUAL "source-core")
    consumer(source-core "-DCONVOLVER_SOURCE_DIR=@CMAKE_CURRENT_SOURCE_DIR@" ${no_optional})
elseif(STEP STREQUAL "source-no-ctest")
    consumer(source-no-ctest "-DCONVOLVER_SOURCE_DIR=@CMAKE_CURRENT_SOURCE_DIR@" -DCONSUMER_CTEST=OFF ${no_optional})
elseif(STEP STREQUAL "installed-io")
    consumer(installed-io -DCONSUMER_IO=ON "-DCONVOLVER_FORBIDDEN_SOURCE=@CMAKE_CURRENT_SOURCE_DIR@/include")
elseif(STEP STREQUAL "missing-io")
    consumer(missing-io -DMISSING_COMPONENT=io)
elseif(STEP STREQUAL "installed-tools")
    # IO-18: the installed command-line tools start and answer -h and
    # --version. TOOL_DIR, the build's own tools folder, is searched only for
    # the libraries they load (Windows keeps vcpkg's DLLs beside them).
    set(bin "${root}/relocated prefix/@CMAKE_INSTALL_BINDIR@")
    if(WIN32)
        file(TO_NATIVE_PATH "${TOOL_DIR}" tool_dir)
        set(ENV{PATH} "${tool_dir};$ENV{PATH}")
    endif()
    function(tool expected)
        execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
        if(NOT result EQUAL 0 OR NOT output MATCHES "${expected}")
            message(FATAL_ERROR "The installed ${ARGN} printed (exit ${result}):\n${output}${error}\n"
                "not the expected ${expected}")
        endif()
    endfunction()
    tool("^Convolver portable CLI\r?\nUsage: convolver " "${bin}/convolver@CMAKE_EXECUTABLE_SUFFIX@" -h)
    tool("^convolver-preset @PROJECT_VERSION@([+][^\n]*)?\r?\n$" "${bin}/convolver-preset@CMAKE_EXECUTABLE_SUFFIX@" --version)
    tool("^Usage: convolver-preset " "${bin}/convolver-preset@CMAKE_EXECUTABLE_SUFFIX@" -h)
elseif(STEP STREQUAL "stale-io")
    # IO-19: a core-only installation over an earlier full one. The prefix
    # keeps the older ConvolverIOTargets.cmake and I/O libraries beside this
    # version's core-only package file; asking for io must still fail, and
    # say why, rather than link the older I/O library. A core-only build has
    # no I/O files of its own to leave, so it plants a stand-in.
    set(stale "${root}/stale prefix")
    file(REMOVE_RECURSE "${stale}")
    file(COPY "${root}/relocated prefix/" DESTINATION "${stale}")
    set(package "${stale}/@package_dir@")
    configure_file("@CMAKE_CURRENT_BINARY_DIR@/consumer-core-only-config.cmake" "${package}/ConvolverConfig.cmake" COPYONLY)
    if(NOT EXISTS "${package}/ConvolverIOTargets.cmake")
        file(WRITE "${package}/ConvolverIOTargets.cmake"
            "add_library(Convolver::io INTERFACE IMPORTED)\n")
    endif()
    consumer(stale-io -DMISSING_COMPONENT=io
        "-DMISSING_MESSAGE=built without the 'io' component \\(CONVOLVER_BUILD_IO=OFF\\)")
elseif(STEP STREQUAL "missing-component")
    consumer(missing-component -DMISSING_COMPONENT=nonexistent)
else()
    message(FATAL_ERROR "Unknown packaging.consumer step '${STEP}'")
endif()
message(STATUS "Consumer ${STEP} passed")
