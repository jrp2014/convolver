# Toolchain/dependency hints for test consumers, never installed with the package.
set(CMAKE_CXX_COMPILER [==[@CMAKE_CXX_COMPILER@]==] CACHE FILEPATH "")
set(CMAKE_BUILD_TYPE [==[@CMAKE_BUILD_TYPE@]==] CACHE STRING "")
set(CMAKE_PREFIX_PATH [==[@CMAKE_PREFIX_PATH@]==] CACHE STRING "")
set(CMAKE_TOOLCHAIN_FILE [==[@CMAKE_TOOLCHAIN_FILE@]==] CACHE FILEPATH "")
set(CMAKE_OSX_SYSROOT [==[@CMAKE_OSX_SYSROOT@]==] CACHE STRING "")
set(CMAKE_OSX_ARCHITECTURES [==[@CMAKE_OSX_ARCHITECTURES@]==] CACHE STRING "")
set(CMAKE_OSX_DEPLOYMENT_TARGET [==[@CMAKE_OSX_DEPLOYMENT_TARGET@]==] CACHE STRING "")
set(VCPKG_TARGET_TRIPLET [==[@VCPKG_TARGET_TRIPLET@]==] CACHE STRING "")
set(CMAKE_DISABLE_FIND_PACKAGE_FFTW3f [==[@CMAKE_DISABLE_FIND_PACKAGE_FFTW3f@]==] CACHE BOOL "")
set(CONVOLVER_FFT_BACKEND [==[@fft_backend@]==] CACHE STRING "")
