{
  "schema": 1,
  "description": "Convolver configuration compatibility corpus. See README.md.",
  "defaults": {"block_sizes": [1, 3, 17, 256], "latency_modes": ["trim", "keep"]},
  "error_patterns": {
    "cycle": "configuration list cycle",
    "missing-asset": "cannot open audio input|cannot read",
    "no-match": "cannot be used with|does not match|none of the [0-9]+ filters",
    "invalid": "invalid configuration",
    "nonportable-path": "Windows drive/rooted paths"
  },
  "error_codes": {
    "cycle": ["cycle"],
    "missing-asset": ["missing-asset", "unreadable"],
    "no-match": ["no-match"],
    "invalid": ["syntax", "rate-mismatch", "ir-channel", "engine", "limit"],
    "nonportable-path": ["nonportable-path"]
  },
  "cases": [
    {
      "id": "wav-identity",
      "label": "spec-derived",
      "evidence": "docs/historical/convolver-4.4/config.html",
      "description": "A sound file used directly as the filter; unit impulse.",
      "files": {"ir.wav": {"rate": 48000, "format": "float", "channels": [[1.0]]}},
      "filter": "ir.wav",
      "input": {"rate": 48000, "channels": 1, "frames": 37},
      "expect": {
        "selected": "ir.wav",
        "output_channels": 1,
        "channel_mask": 0,
        "input_delays": [0],
        "output_delays": [0],
        "paths": [{"ir": "ir.wav", "channel": 0, "inputs": [[0, 1]], "outputs": [[0, 1]]}],
        "frames": 37
      },
      "portable_paths_warnings": []
    },
