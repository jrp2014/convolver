      "label": "spec-derived",
      "evidence": "docs/historical/convolver-4.4/config.html",
      "description": "A list selects the first entry matching rate and input channels; a later matching entry with inverted gain is not used.",
      "files": {
        "ir.wav": {"rate": 48000, "format": "float", "channels": [[1.0, 0.5]]},
        "ir44.wav": {"rate": 44100, "format": "float", "channels": [[1.0]]},
        "r44.cfg": {"text": "44100 2 2 0\n0 0\n0 0\nir44.wav\n0\n0\n0\n"},
        "r48mono.cfg": {"text": "48000 1 1 0\n0\n0\nir.wav\n0\n0\n0\n"},
        "r48stereo.cfg": {"text": "48000 2 2 0\n0 0\n0 0\nir.wav\n0\n1\n0\n"},
        "r48stereo-b.cfg": {"text": "48000 2 2 0\n0 0\n0 0\nir.wav\n0\n-1\n0\n"},
        "filters.txt": {"text": "r44.cfg\nr48mono.cfg\nr48stereo.cfg\nr48stereo-b.cfg\n"}
      },
      "filter": "filters.txt",
      "input": {"rate": 48000, "channels": 2, "frames": 22},
      "expect": {
